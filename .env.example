# Copia este fichero a .env.local (no se sube a git).
# Con Neon, `neon checkout dev` rellena DATABASE_URL y DATABASE_URL_UNPOOLED automáticamente.

# Conexión de la aplicación (en Neon, la pooled: host con -pooler)
DATABASE_URL=postgres://search_magic:search_magic@localhost:5432/search_magic
# Conexión directa para migraciones e importación de Scryfall (en local, la misma)
DATABASE_URL_UNPOOLED=postgres://search_magic:search_magic@localhost:5432/search_magic

# Contacto que va en el User-Agent hacia Scryfall y las tiendas (usa un correo del proyecto)
SEARCH_MAGIC_CONTACT=contacto@example.com

# Origen de datos de la web: mock (datos de ejemplo) o db
DATA_SOURCE=mock

# Contraseña del panel /admin (HTTP Basic, usuario cualquiera). Vacía = panel sin proteger (solo en local)
ADMIN_PASSWORD=
